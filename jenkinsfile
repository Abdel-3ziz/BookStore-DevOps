
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Backend') {
            steps {
                sh '''
                    docker build -t abdel3ziz/bookstore-backend:1.0 ./backend
                '''
            }
        }

        stage('Build Frontend') {
            steps {
                sh '''
                    docker build -t abdel3ziz/bookstore-frontend:1.0 ./frontend
                '''
            }
        }

        stage('Push Images') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin

                        docker push abdel3ziz/bookstore-backend:1.0
                        docker push abdel3ziz/bookstore-frontend:1.0

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([string(
                    credentialsId: 'k8s-jenkins-token',
                    variable: 'K8S_TOKEN'
                )]) {

                    sh '''
                        set -e

                        echo "Configuring Kubernetes..."

                        kubectl config set-cluster docker-desktop \
                            --server=https://host.docker.internal:61224 \
                            --insecure-skip-tls-verify=true

                        kubectl config set-credentials jenkins-deployer \
                            --token="$K8S_TOKEN"

                        kubectl config set-context jenkins-deployer-context \
                            --cluster=docker-desktop \
                            --user=jenkins-deployer \
                            --namespace=bookstore

                        kubectl config use-context jenkins-deployer-context

                        echo "Checking Kubernetes permissions..."
                        kubectl auth can-i get pods -n bookstore

                        echo "Creating Kubernetes Secret..."

                        cat > k8s/config/secret.yml <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: bookstore-secret
  namespace: bookstore
type: Opaque
data:
  DB_PASSWORD: Ym9va3N0b3JlX3Bhc3M=
  DB_USER: Ym9va3N0b3JlX3VzZXI=
EOF

                        echo "Deploying application..."

                        kubectl apply -f k8s/config/configmap.yml
                        kubectl apply -f k8s/config/secret.yml
                        kubectl apply -f k8s/database/pvc.yml
                        kubectl apply -f k8s/database/service.yml
                        kubectl apply -f k8s/database/statefulset.yml
                        kubectl apply -f k8s/backend/deployment.yml
                        kubectl apply -f k8s/backend/service.yml
                        kubectl apply -f k8s/frontend/deployment.yml
                        kubectl apply -f k8s/frontend/service.yml
                        kubectl apply -f k8s/ingress/ingress.yml

                        echo "Deployment completed successfully!"

                        kubectl get pods -n bookstore
                        kubectl get services -n bookstore
                    '''
                }
            }
        }
    }
}

