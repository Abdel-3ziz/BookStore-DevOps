pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }

        stage('Build Images') {
            steps {
                sh 'docker build -t bookstore-backend:ci ./backend'
                sh 'docker build -t bookstore-frontend:ci ./frontend'
            }
        }
    }
}