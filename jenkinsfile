pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }

        stage('Build Backend') {
            steps {
                sh 'docker build -t abdel3ziz/bookstore-backend:1.0 ./backend'
            }
        }

        stage('Build Frontend') {
            steps {
                sh 'docker build -t abdel3ziz/bookstore-frontend:1.0 ./frontend'
            }
        }

        stage('Push Images') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker push abdel3ziz/bookstore-backend:1.0
                        docker push abdel3ziz/bookstore-frontend:1.0
                        docker logout
                    '''
                }
            }
        stage('Deploy to Kubernetes') {
            steps {
                    sh '''
                        kubectl apply -f k8s/namespace/namespace.yml
                        kubectl apply -R -f k8s/backend
                        kubectl apply -R -f k8s/config
                        kubectl apply -R -f k8s/database
                        kubectl apply -R -f k8s/frontend
                        kubectl apply -R -f k8s/ingress
                        kubectl apply -R -f k8s/rbac
                        '''
    }
}
        }
    }
}