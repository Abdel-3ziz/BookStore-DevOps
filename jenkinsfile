pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }

        stage('Build backend') {
            steps {
                sh 'docker build -t abdel3ziz/bookstore-backend:ci ./backend'
                
            }
        }
        stage('Build Frontend') {
            steps {
                sh 'docker build -t abdel3ziz/bookstore-frontend:ci ./frontend'
            }
        }
    }
}